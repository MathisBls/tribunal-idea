{
  "name": "tribunal-idea",
  "private": true,
  "version": "1.0.0",
  "description": "Un tribunal de personas IA qui débattent d'une question et rendent un verdict, avec votre propre compte Claude.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node server/index.mjs\" \"vite --port 5280 --strictPort\"",
    "build": "vite build",
    "start": "vite build && node server/index.mjs --serve-dist",
    "bridge": "node server/index.mjs"
  },
  "dependencies": {
    "express": "4.21.2"
  },
  "devDependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "vite": "6.0.7"
  },
  "bin": {
    "tribunal-idea": "server/index.mjs"
  }
}
